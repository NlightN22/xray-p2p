{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NlightN22/xray-p2p/schemas/xp2p-client.schema.json",
  "title": "xp2p client TOML configuration",
  "description": "Schema for xp2p-client.toml Desired inputs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logging": { "$ref": "#/$defs/logging" },
    "client": { "$ref": "#/$defs/client" },
    "xray_assets": { "$ref": "#/$defs/xray_assets" }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "cidr": {
      "type": "string",
      "pattern": "^([^/\\s]+)/(\\d{1,3})$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._@:+-]+$"
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "format": { "type": "string", "enum": ["text", "json"] }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install_dir": { "type": "string" },
        "config_dir": { "type": "string" },
        "server_address": { "$ref": "#/$defs/host" },
        "server_port": { "type": "string", "pattern": "^[0-9]{1,5}$" },
        "diag_port": { "type": "string", "pattern": "^[0-9]{1,5}$" },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "server_name": { "type": "string" },
        "allow_insecure": { "type": "boolean" },
        "socks_address": { "type": "string", "pattern": "^[^\\s:]+:[0-9]{1,5}$" },
        "tun_enabled": { "type": "boolean" },
        "tun_name": { "type": "string", "minLength": 1 },
        "tun_mtu": { "type": "integer", "minimum": 576, "maximum": 9000 },
        "tun_addr": { "$ref": "#/$defs/cidr" },
        "tun_mode": { "type": "string", "enum": ["split", "full", "proxy"] },
        "dns_servers": { "type": "array", "items": { "$ref": "#/$defs/host" }, "uniqueItems": true },
        "full_tunnel_verbose": { "type": "boolean" },
        "full_tunnel_tag": { "type": "string" },
        "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
        "endpoint_groups": { "type": "array", "items": { "$ref": "#/$defs/endpoint_group" } },
        "redirects": { "type": "array", "items": { "$ref": "#/$defs/redirect" } },
        "reverse": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/reverse_channel" }
        },
        "forwards": { "type": "array", "items": { "$ref": "#/$defs/forward" } }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "tag", "address", "port", "user", "password"],
      "properties": {
        "profile": { "type": "string", "enum": ["trojan-tls", "vless-tls-vision"] },
        "protocol": { "type": "string", "enum": ["trojan", "vless"] },
        "transport": { "type": "string", "enum": ["tcp"] },
        "security": { "type": "string", "enum": ["tls"] },
        "flow": { "type": "string", "enum": ["xtls-rprx-vision"] },
        "hostname": { "$ref": "#/$defs/host" },
        "tag": { "$ref": "#/$defs/tag" },
        "address": { "$ref": "#/$defs/host" },
        "port": { "$ref": "#/$defs/port" },
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "server_name": { "type": "string" },
        "alpn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allow_insecure": { "type": "boolean" },
        "pinned_peer_cert_sha256": { "type": "string", "pattern": "^$|^[A-Fa-f0-9:]{64,95}$" },
        "verify_peer_cert_by_name": { "type": "string" },
        "disabled": { "type": "boolean" }
      }
    },
    "endpoint_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "tag", "members"],
      "properties": {
        "group_id": { "type": "string", "minLength": 1 },
        "tag": { "$ref": "#/$defs/tag" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "minItems": 1, "uniqueItems": true },
        "mode": { "type": "string", "enum": ["automatic", "manual", "disabled"] },
        "failure_threshold": { "type": "integer", "minimum": 1 },
        "success_threshold": { "type": "integer", "minimum": 1 },
        "cooldown_seconds": { "type": "integer", "minimum": 0 },
        "minimum_hold_seconds": { "type": "integer", "minimum": 0 },
        "automatic_failback": { "type": "boolean" },
        "manual_active_tag": { "$ref": "#/$defs/tag" }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outbound_tag"],
      "oneOf": [{ "required": ["cidr"] }, { "required": ["domain"] }],
      "properties": {
        "cidr": { "$ref": "#/$defs/cidr" },
        "domain": { "$ref": "#/$defs/host" },
        "outbound_tag": { "$ref": "#/$defs/tag" },
        "no_routes": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "access": { "type": "string", "enum": ["all", "restricted"] },
        "users": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "groups": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "reverse_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "host", "tag", "domain", "endpoint_tag"],
      "properties": {
        "channel_id": { "type": "string" },
        "user_id": { "type": "string", "minLength": 1 },
        "host": { "$ref": "#/$defs/host" },
        "tag": { "$ref": "#/$defs/tag" },
        "domain": { "$ref": "#/$defs/host" },
        "endpoint_tag": { "$ref": "#/$defs/tag" },
        "group_tag": { "$ref": "#/$defs/tag" },
        "disabled": { "type": "boolean" }
      }
    },
    "forward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen_address", "listen_port", "target_host", "target_port", "protocol", "tag"],
      "properties": {
        "listen_address": { "$ref": "#/$defs/host" },
        "listen_port": { "$ref": "#/$defs/port" },
        "target_host": { "$ref": "#/$defs/host" },
        "target_port": { "$ref": "#/$defs/port" },
        "protocol": { "type": "string", "enum": ["tcp", "udp", "both"] },
        "tag": { "$ref": "#/$defs/tag" },
        "remark": { "type": "string" }
      }
    },
    "xray_assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_after": { "$ref": "#/$defs/duration" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/xray_asset" } }
      }
    },
    "xray_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.dat$|^[A-Za-z0-9._-]+$" },
        "url": { "type": "string", "format": "uri" },
        "stale_after": { "$ref": "#/$defs/duration" }
      }
    }
  }
}

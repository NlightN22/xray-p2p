{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://raw.githubusercontent.com/NlightN22/xray-p2p/main/schemas/xp2p-client.schema.json",
  "title": "xp2p client TOML configuration",
  "description": "Schema for xp2p-client.toml Desired inputs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logging": { "$ref": "#/definitions/logging" },
    "client": { "$ref": "#/definitions/client" },
    "xray_assets": { "$ref": "#/definitions/xray_assets" }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "optional_host": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9._:-]+$"
    },
    "cidr": {
      "type": "string",
      "pattern": "^([^/\\s]+)/(\\d{1,3})$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._@:+-]+$"
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "format": { "type": "string", "enum": ["text", "json"] }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install_dir": { "type": "string" },
        "config_dir": { "type": "string" },
        "server_address": { "$ref": "#/definitions/host" },
        "server_port": { "type": "string", "pattern": "^[0-9]{1,5}$" },
        "diag_port": { "type": "string", "pattern": "^[0-9]{1,5}$" },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "server_name": { "type": "string" },
        "allow_insecure": { "type": "boolean" },
        "socks_address": { "type": "string", "pattern": "^[^\\s:]+:[0-9]{1,5}$" },
        "tun_enabled": { "type": "boolean" },
        "tun_name": { "type": "string", "minLength": 1 },
        "tun_mtu": { "type": "integer", "minimum": 576, "maximum": 9000 },
        "tun_addr": { "$ref": "#/definitions/cidr" },
        "tun_mode": { "type": "string", "enum": ["split", "full", "proxy"] },
        "dns_servers": { "type": "array", "items": { "$ref": "#/definitions/host" }, "uniqueItems": true },
        "full_tunnel_verbose": { "type": "boolean" },
        "full_tunnel_tag": { "type": "string" },
        "endpoints": { "type": "array", "items": { "$ref": "#/definitions/endpoint" } },
        "endpoint_groups": { "type": "array", "items": { "$ref": "#/definitions/endpoint_group" } },
        "redirects": { "type": "array", "items": { "$ref": "#/definitions/redirect" } },
        "reverse": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/reverse_channel" }
        },
        "forwards": { "type": "array", "items": { "$ref": "#/definitions/forward" } },
        "xray": { "$ref": "#/definitions/client_xray" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "tag", "address", "port", "user", "password"],
      "properties": {
        "profile": { "type": "string", "enum": ["trojan-tls", "vless-tls-vision"] },
        "protocol": { "type": "string", "enum": ["trojan", "vless"] },
        "transport": { "type": "string", "enum": ["tcp"] },
        "security": { "type": "string", "enum": ["tls"] },
        "flow": { "type": "string", "enum": ["xtls-rprx-vision"] },
        "hostname": { "$ref": "#/definitions/host" },
        "tag": { "$ref": "#/definitions/tag" },
        "address": { "$ref": "#/definitions/host" },
        "port": { "$ref": "#/definitions/port" },
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "server_name": { "type": "string" },
        "alpn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allow_insecure": { "type": "boolean" },
        "pinned_peer_cert_sha256": { "type": "string", "pattern": "^$|^[A-Fa-f0-9:]{64,95}$" },
        "verify_peer_cert_by_name": { "type": "string" },
        "disabled": { "type": "boolean" }
      }
    },
    "endpoint_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "tag", "members"],
      "properties": {
        "group_id": { "type": "string", "minLength": 1 },
        "tag": { "$ref": "#/definitions/tag" },
        "members": { "type": "array", "items": { "$ref": "#/definitions/tag" }, "minItems": 1, "uniqueItems": true },
        "mode": { "type": "string", "enum": ["automatic", "manual", "disabled"] },
        "failure_threshold": { "type": "integer", "minimum": 1 },
        "success_threshold": { "type": "integer", "minimum": 1 },
        "cooldown_seconds": { "type": "integer", "minimum": 0 },
        "minimum_hold_seconds": { "type": "integer", "minimum": 0 },
        "automatic_failback": { "type": "boolean" },
        "manual_active_tag": { "$ref": "#/definitions/tag" }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outbound_tag"],
      "anyOf": [{ "required": ["cidr"] }, { "required": ["domain"] }],
      "properties": {
        "cidr": { "$ref": "#/definitions/cidr" },
        "domain": { "$ref": "#/definitions/optional_host" },
        "outbound_tag": { "$ref": "#/definitions/tag" },
        "no_routes": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "access": { "type": "string", "enum": ["all", "restricted"] },
        "users": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "groups": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "reverse_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "host", "tag", "domain", "endpoint_tag"],
      "properties": {
        "channel_id": { "type": "string" },
        "user_id": { "type": "string", "minLength": 1 },
        "host": { "$ref": "#/definitions/host" },
        "tag": { "$ref": "#/definitions/tag" },
        "domain": { "$ref": "#/definitions/host" },
        "endpoint_tag": { "$ref": "#/definitions/tag" },
        "group_tag": { "$ref": "#/definitions/tag" },
        "disabled": { "type": "boolean" }
      }
    },
    "forward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen_address", "listen_port", "target_host", "target_port", "protocol", "tag"],
      "properties": {
        "listen_address": { "$ref": "#/definitions/host" },
        "listen_port": { "$ref": "#/definitions/port" },
        "target_host": { "$ref": "#/definitions/host" },
        "target_port": { "$ref": "#/definitions/port" },
        "protocol": { "type": "string", "enum": ["tcp", "udp", "both"] },
        "tag": { "$ref": "#/definitions/tag" },
        "remark": { "type": "string" }
      }
    },
    "client_xray": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inbounds": { "$ref": "#/definitions/client_xray_inbounds" },
        "logs": { "$ref": "#/definitions/xray_logs" },
        "routing": { "$ref": "#/definitions/xray_routing" },
        "direct_outbound": { "$ref": "#/definitions/xray_direct_outbound" }
      }
    },
    "client_xray_inbounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socks": { "$ref": "#/definitions/xray_socks_inbound" },
        "dokodemo": { "$ref": "#/definitions/xray_dokodemo_inbound" },
        "tun": { "$ref": "#/definitions/xray_tun_inbound" }
      }
    },
    "xray_port": {
      "type": "number",
      "minimum": 0,
      "maximum": 65535,
      "multipleOf": 1
    },
    "xray_socks_inbound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "protocol": { "type": "string", "enum": ["socks"] },
        "listen": { "type": "string" },
        "port": { "$ref": "#/definitions/xray_port" },
        "udp": { "type": "boolean" }
      }
    },
    "xray_dokodemo_inbound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "remark": { "type": "string" },
        "protocol": { "type": "string", "enum": ["dokodemo-door"] },
        "listen": { "type": "string" },
        "port": { "$ref": "#/definitions/xray_port" },
        "network": { "type": "string", "enum": ["tcp", "udp", "tcp,udp"] },
        "follow_redirect": { "type": "boolean" }
      }
    },
    "xray_tun_inbound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "protocol": { "type": "string", "enum": ["tun"] },
        "port": { "$ref": "#/definitions/xray_port" }
      }
    },
    "xray_logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["debug", "info", "warning", "error", "none"] },
        "access": { "type": "string" },
        "stats_enabled": { "type": "boolean" },
        "api": { "$ref": "#/definitions/xray_api" },
        "policy": { "$ref": "#/definitions/xray_policy" }
      }
    },
    "xray_api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "listen": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "xray_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": { "type": "object", "additionalProperties": { "$ref": "#/definitions/xray_policy_level" } },
        "system": { "$ref": "#/definitions/xray_policy_system" }
      }
    },
    "xray_policy_level": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stats_user_downlink": { "type": "boolean" },
        "stats_user_uplink": { "type": "boolean" },
        "stats_user_online": { "type": "boolean" }
      }
    },
    "xray_policy_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stats_inbound_downlink": { "type": "boolean" },
        "stats_inbound_uplink": { "type": "boolean" },
        "stats_outbound_downlink": { "type": "boolean" },
        "stats_outbound_uplink": { "type": "boolean" }
      }
    },
    "xray_routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_strategy": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "xray_direct_outbound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string" },
        "protocol": { "type": "string", "enum": ["freedom"] },
        "domain_strategy": { "type": "string" },
        "send_through": { "type": "string" }
      }
    },
    "xray_assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_after": { "$ref": "#/definitions/duration" },
        "files": { "type": "array", "items": { "$ref": "#/definitions/xray_asset" } }
      }
    },
    "xray_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.dat$|^[A-Za-z0-9._-]+$" },
        "url": { "type": "string", "format": "uri" },
        "stale_after": { "$ref": "#/definitions/duration" }
      }
    }
  }
}



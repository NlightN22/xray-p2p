<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="xp2p" Language="1033" Version="$(var.ProductVersion)" Manufacturer="xp2p" UpgradeCode="{E99A193E-D6A9-4743-93D8-EB45053E517A}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" InstallPrivileges="elevated" Platform="x64" Description="xp2p tunnel service" />
    <util:CloseApplication Id="CloseXp2pUi"
                           Target="xp2p-ui.exe"
                           Description="xp2p UI is running."
                           CloseMessage="yes"
                           PromptToContinue="yes"
                           RebootPrompt="no"
                           TerminateProcess="1">REMOVE="ALL"</util:CloseApplication>

    <Condition Message="xp2p requires 64-bit Windows.">VersionNT64</Condition>

    <MajorUpgrade Schedule="afterInstallValidate"
                  AllowDowngrades="no"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of xp2p is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCONTACT" Value="xp2p maintainers" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/NlightN22/xray-p2p" />
    <Property Id="ARPHELPLINK" Value="https://github.com/NlightN22/xray-p2p/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/NlightN22/xray-p2p/releases" />
    <Property Id="ARPCOMMENTS" Value="Minimal Trojan tunnel based on xray-core." />
    <Property Id="XP2P_CLIENT_ARGS" Hidden="yes" Secure="yes" />
    <Property Id="XP2P_SERVER_ARGS" Hidden="yes" Secure="yes" />
    <Property Id="XP2P_SKIP_SERVICE_START" Hidden="yes" Secure="yes" Value="1" />
    <Property Id="XP2P_UI_AUTOSTART" Hidden="yes" Secure="yes" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch xp2p UI" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\wix\license.rtf" />

    <CustomAction Id="SetRegisterPsCompletion"
                  Property="RegisterPsCompletion"
                  Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#fileRegisterPsCompletion]&quot; -CompletionPath &quot;[#fileXp2pCompletion]&quot; -InstallRoot &quot;[INSTALLFOLDER]&quot;" />

    <CustomAction Id="RegisterPsCompletion"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <CustomAction Id="SetServiceAclCommand"
                  Property="GrantServiceAcl"
                  Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#fileSetServiceAcl]&quot; -ServiceName xp2p-client,xp2p-server -Sid S-1-5-32-545,S-1-5-11" />

    <CustomAction Id="GrantServiceAcl"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <CustomAction Id="SetPerUserInstall" Property="MSIINSTALLPERUSER" Value="1" Execute="immediate" />
    <CustomAction Id="SetPerUserFolder" Property="INSTALLFOLDER" Value="[LocalAppDataFolder]xp2p" Execute="immediate" />

    <CustomAction Id="RunClientInstall"
                  FileKey="fileXp2pExe"
                  ExeCommand='client install [XP2P_CLIENT_ARGS]'
                  Execute="deferred"
                  Return="check"
                  Impersonate="yes" />

    <CustomAction Id="RunServerInstall"
                  FileKey="fileXp2pExe"
                  ExeCommand='server install [XP2P_SERVER_ARGS]'
                  Execute="deferred"
                  Return="check"
                  Impersonate="yes" />

    <CustomAction Id="LaunchXp2pUI"
                  FileKey="fileXp2pUiExe"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="SetPerUserInstall" Before="CostFinalize">NOT Privileged</Custom>
      <Custom Action="SetPerUserFolder" Before="CostFinalize">NOT Privileged</Custom>
      <Custom Action="SetRegisterPsCompletion" After="InstallFiles">NOT REMOVE="ALL"</Custom>
      <Custom Action="RegisterPsCompletion" After="SetRegisterPsCompletion">NOT REMOVE="ALL"</Custom>
      <Custom Action="SetServiceAclCommand" After="InstallServices">NOT REMOVE="ALL"</Custom>
      <Custom Action="GrantServiceAcl" After="SetServiceAclCommand">NOT REMOVE="ALL"</Custom>
      <Custom Action="RunClientInstall" After="InstallFiles">NOT Installed AND XP2P_CLIENT_ARGS</Custom>
      <Custom Action="RunServerInstall" After="RunClientInstall">NOT Installed AND XP2P_SERVER_ARGS</Custom>
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="SetPerUserInstall" Before="CostFinalize">NOT Privileged</Custom>
      <Custom Action="SetPerUserFolder" Before="CostFinalize">NOT Privileged</Custom>
    </InstallUISequence>

    <UI>
      <UIRef Id="WixUI_FeatureTree" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchXp2pUI">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="xp2p">
          <Directory Id="BinFolder" Name="bin" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="Xp2pProgramMenuFolder" Name="xp2p" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="CommonAppDataFolder">
        <Directory Id="Xp2pDataFolder" Name="xp2p">
          <Directory Id="Xp2pCompletionsFolder" Name="completions" />
          <Directory Id="Xp2pConfigClientFolder" Name="config-client" />
          <Directory Id="Xp2pConfigServerFolder" Name="config-server" />
          <Directory Id="Xp2pLogsFolder" Name="logs" />
        </Directory>
      </Directory>
      <Directory Id="LocalAppDataFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpXp2pExe" Guid="{6A53942E-0C09-4164-9F15-A41E4630FA8E}" Win64="yes">
        <File Id="fileXp2pExe" Source="$(var.Xp2pBinary)" KeyPath="yes" Checksum="yes" />
        <ServiceInstall Id="SvcInstallClient"
                        Name="xp2p-client"
                        DisplayName="xp2p Client Service"
                        Description="xp2p client tunnel service"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Vital="yes"
                        Account="LocalSystem"
                        Arguments='client service run' />
        <ServiceControl Id="SvcControlClient"
                        Name="xp2p-client"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
        <ServiceInstall Id="SvcInstallServer"
                        Name="xp2p-server"
                        DisplayName="xp2p Server Service"
                        Description="xp2p server tunnel service"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Vital="yes"
                        Account="LocalSystem"
                        Arguments='server service run' />
        <ServiceControl Id="SvcControlServer"
                        Name="xp2p-server"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="cmpXp2pUiExe" Guid="{7F5B7E9F-2DD4-4F90-9B74-42A99D71B17E}" Win64="yes">
        <File Id="fileXp2pUiExe" Source="$(var.Xp2pUiBinary)" KeyPath="yes" Checksum="yes" />
      </Component>

      <Component Id="cmpXp2pUiStartMenu" Guid="{260AABB9-911B-43CE-8233-41E6BBB7153E}" Win64="yes">
        <Shortcut Id="ShortcutXp2pUiStartMenu"
                  Directory="Xp2pProgramMenuFolder"
                  Name="xp2p UI"
                  Description="xp2p UI"
                  Target="[INSTALLFOLDER]xp2p-ui.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveXp2pProgramMenuFolder" Directory="Xp2pProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\xp2p"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="cmpInstallRoot" Guid="{6F63342C-ED20-4D49-B0EC-5688E0C21818}" Win64="yes" KeyPath="yes">
        <CreateFolder />
      </Component>

      <Component Id="cmpRegisterPsCompletion" Guid="{E1F6E8D4-4F1C-4DCE-9D6A-8D2F9C0D8B7A}" Win64="yes">
        <File Id="fileRegisterPsCompletion" Source="$(var.RegisterPsCompletionScript)" KeyPath="yes" />
      </Component>

      <Component Id="cmpSetServiceAclScript" Guid="{5E83F3F7-2AB3-4CFA-B3C4-1E4250AA9E01}" Win64="yes">
        <File Id="fileSetServiceAcl" Source="$(var.SetServiceAclScript)" KeyPath="yes" />
      </Component>

      <Component Id="cmpServiceAutostart" Guid="{E0F23327-5C68-4699-98A5-1E4D91550ABA}" Win64="yes">
        <Condition>XP2P_SKIP_SERVICE_START="0"</Condition>
        <RegistryValue Root="HKLM"
                       Key="Software\xp2p"
                       Name="ServiceAutostart"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <ServiceControl Id="SvcControlClientAutoStart"
                        Name="xp2p-client"
                        Start="install"
                        Wait="yes" />
        <ServiceControl Id="SvcControlServerAutoStart"
                        Name="xp2p-server"
                        Start="install"
                        Wait="yes" />
      </Component>

      <Component Id="cmpXp2pUiAutoStart" Guid="{A0BC8E26-5F2B-4D8D-9044-70EF4F9C6B1B}" Win64="yes">
        <Condition>XP2P_UI_AUTOSTART="1"</Condition>
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="xp2p-ui"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]xp2p-ui.exe&quot;"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="Xp2pDataFolder">
      <Component Id="cmpXp2pDataRoot" Guid="{CB9F9DB5-76DD-49E0-9A77-5F7A4E2BDCA0}" Win64="yes" KeyPath="yes">
        <CreateFolder>
          <Permission User="Users" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="Xp2pCompletionsFolder">
      <Component Id="cmpXp2pCompletion" Guid="{1E4A2B6C-2E3E-4E31-AD4F-7E7F1FAE3A0C}" Win64="yes">
        <File Id="fileXp2pCompletion" Source="$(var.Xp2pCompletionScript)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="Xp2pConfigClientFolder">
      <Component Id="cmpXp2pConfigClient" Guid="{B0A5E1C6-56AA-4F1E-88F7-9A9C5A32339A}" Win64="yes" KeyPath="yes">
        <CreateFolder>
          <Permission User="Users" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="Xp2pConfigServerFolder">
      <Component Id="cmpXp2pConfigServer" Guid="{F8E8A0A4-7B6B-4D0B-9A9A-0B0D86C1DFA7}" Win64="yes" KeyPath="yes">
        <CreateFolder>
          <Permission User="Users" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="Xp2pLogsFolder">
      <Component Id="cmpXp2pLogsRoot" Guid="{E3E83E72-3F2B-4C3B-A3A4-9EA6E6110A21}" Win64="yes" KeyPath="yes">
        <CreateFolder>
          <Permission User="Users" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="cmpXp2pUiDesktopShortcut" Guid="{8F3EC8B6-90BB-4CEB-9262-CEA891CECCDE}" Win64="yes">
        <Shortcut Id="ShortcutXp2pUiDesktop"
                  Directory="DesktopFolder"
                  Name="xp2p UI"
                  Description="xp2p UI"
                  Target="[INSTALLFOLDER]xp2p-ui.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\xp2p"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="xp2p" Level="1" Display="hidden">
      <ComponentRef Id="cmpXp2pExe" />
      <ComponentRef Id="cmpInstallRoot" />
      <ComponentRef Id="cmpRegisterPsCompletion" />
      <ComponentRef Id="cmpSetServiceAclScript" />
      <ComponentRef Id="cmpXp2pDataRoot" />
      <ComponentRef Id="cmpXp2pCompletion" />
      <ComponentRef Id="cmpXp2pConfigClient" />
      <ComponentRef Id="cmpXp2pConfigServer" />
      <ComponentRef Id="cmpXp2pLogsRoot" />
      <ComponentGroupRef Id="Xp2pBundleGroup" />
      <ComponentRef Id="cmpServiceAutostart" />
    </Feature>

    <Feature Id="TrayFeature" Title="xp2p UI" Level="1" Display="hidden">
      <ComponentRef Id="cmpXp2pUiExe" />
      <ComponentRef Id="cmpXp2pUiAutoStart" />
      <ComponentRef Id="cmpXp2pUiStartMenu" />
    </Feature>

    <Feature Id="DesktopShortcutFeature"
             Title="Desktop shortcut"
             Description="Create a desktop shortcut for xp2p UI"
             Level="1">
      <ComponentRef Id="cmpXp2pUiDesktopShortcut" />
    </Feature>
  </Product>
</Wix>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ui-xp2p</AssemblyName>
    <RootNamespace>Xp2pUi</RootNamespace>
    <ApplicationIcon>..\..\assets\xp2p.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\xp2p.ico">
      <Link>assets\xp2p.ico</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\Base.png">
      <LogicalName>assets/Base.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\Disabled.png">
      <LogicalName>assets/Disabled.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\Enabled.png">
      <LogicalName>assets/Enabled.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\Enabling.png">
      <LogicalName>assets/Enabling.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="ModernWpfUI" Version="0.9.7-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xp2pUi.Tests" />
  </ItemGroup>
</Project>
